<Window x:Class="HaylouFaceEditor.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hex color picker" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#404040" Geometry="M0,0 H12 V12 H0 Z"/>
                <GeometryDrawing Brush="#606060" Geometry="M0,0 H6 V6 H0 Z M6,6 H12 V12 H6 Z"/>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Hex color picker" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a color or paste its hexadecimal value." Style="{StaticResource StudioHelp}" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid x:Name="ColorSurface" Grid.Row="1" ClipToBounds="True" Cursor="Cross" SizeChanged="SurfaceSizeChanged"
              MouseLeftButtonDown="SurfaceDown" MouseMove="SurfaceMove" MouseLeftButtonUp="SurfaceUp">
            <Border x:Name="HueFill"/>
            <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
            <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Border.Background></Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="ColorCursor" Width="14" Height="14" Stroke="White" StrokeThickness="2"><Ellipse.Effect><DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="1"/></Ellipse.Effect></Ellipse>
            </Canvas>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Hue" Style="{StaticResource StudioFieldLabel}"/>
            <Grid Margin="0,6,0,0">
                <Border Height="10" CornerRadius="2"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Red" Offset="0"/><GradientStop Color="Yellow" Offset="0.166667"/><GradientStop Color="Lime" Offset="0.333333"/><GradientStop Color="Cyan" Offset="0.5"/><GradientStop Color="Blue" Offset="0.666667"/><GradientStop Color="Magenta" Offset="0.833333"/><GradientStop Color="Red" Offset="1"/>
                </LinearGradientBrush></Border.Background></Border>
                <Slider x:Name="HueSlider" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" Background="Transparent" ValueChanged="HueChanged" ToolTip="Hue (0-360 degrees)"/>
            </Grid>
        </StackPanel>
        <StackPanel x:Name="OpacityPanel" Grid.Row="3" Margin="0,12,0,0">
            <DockPanel><TextBlock Text="Opacity" Style="{StaticResource StudioFieldLabel}"/><TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></DockPanel>
            <Grid Margin="0,6,0,0">
                <Border Height="10" Background="{StaticResource Checker}"><Border x:Name="OpacityGradient"/></Border>
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" Background="Transparent" ValueChanged="OpacityChanged" ToolTip="Image opacity"/>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,14,0">
                <TextBlock x:Name="HexLabel" Text="HEX / #RRGGBB" Style="{StaticResource StudioFieldLabel}" Margin="0,0,0,5"/>
                <TextBox x:Name="HexBox" FontFamily="Consolas" FontSize="16" MaxLength="9" TextChanged="HexChanged"/>
                <TextBlock x:Name="RgbValue" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Current" Style="{StaticResource StudioFieldLabel}" Margin="0,0,0,5"/>
                <Border Background="{StaticResource Checker}" Height="40"><Border x:Name="CurrentPreview"/></Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="New" Style="{StaticResource StudioFieldLabel}" Margin="0,0,0,5"/>
                <Border Background="{StaticResource Checker}" Height="40"><Border x:Name="NewPreview"/></Border>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ValidationText" Grid.Row="5" Foreground="#FFD54F" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource StudioToolButton}" Margin="0,0,8,0"/>
            <Button x:Name="ApplyButton" Content="Apply color" IsDefault="True" Click="ApplyClick" Style="{StaticResource StudioAccentButton}"/>
        </StackPanel>
    </Grid>
</Window>
