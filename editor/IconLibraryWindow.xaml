<Window x:Class="HaylouFaceEditor.IconLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Built-in icon library" Width="780" Height="740" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Icon library" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Use Ctrl+click to select several icons, or Shift+click for a range. Selected icons become frames of one sequence."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Search icons" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="SearchBox" TextChanged="FilterChanged" ToolTip="Search by name or category"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Category" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CategoryBox" SelectionChanged="CategoryChanged"/>
            </StackPanel>
            <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <Button Content="Select all shown" Padding="8,4" FontSize="12" Margin="0,0,6,0" Click="SelectShownClick"/>
                <Button Content="Clear selection" Padding="8,4" FontSize="12" Margin="0,0,10,0" Click="ClearSelectionClick"/>
                <TextBlock Text="Selection is kept when filtering." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Grid>
        <ListBox x:Name="IconList" Grid.Row="2" Background="{StaticResource Paper}" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                 SelectionMode="Extended" SelectionChanged="IconSelected" MouseDoubleClick="AddDoubleClick">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,8,8"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter Property="Background" Value="{StaticResource Panel}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Background" Value="#45382B"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="118" ToolTip="{Binding ResourceName}">
                        <Image Source="{Binding Preview}" Width="44" Height="44" Stretch="Uniform" Margin="0,4,0,8"/>
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Height="36" FontSize="12" TextAlignment="Center"/>
                        <TextBlock Text="{Binding FrameDescription}" Foreground="{StaticResource Muted}" FontSize="11" TextAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Margin="0,0,0,10">
                <TextBlock x:Name="ResultCount" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="SelectionInfo" Text="Select an icon" TextWrapping="Wrap"/>
                <TextBlock x:Name="AppendInfo" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="AppendIconButton" Content="Add to selected sequence" IsEnabled="False" Margin="0,0,8,0" Click="AppendClick"/>
                <Button x:Name="AddIconButton" Content="Add icon" IsEnabled="False" Click="AddClick" IsDefault="True"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
