<Window x:Class="HaylouFaceEditor.PngFontWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create a PNG font" Width="760" Height="720" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="PNG font" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="FontInstructions" Text="Assign one character to each image. Include all digits 0–9 for a numeric data source. Original colors and transparency are preserved."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Font name" Margin="0,0,0,4"/><TextBox x:Name="FontNameBox" Text="PNG font"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Preview text" Margin="0,0,0,4"/><TextBox x:Name="PreviewTextBox" Text="0123456789" MaxLength="12" TextChanged="PreviewChanged"/></StackPanel>
        </Grid>
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Button Content="Add images" Click="AddImagesClick" Margin="0,0,8,0"/>
            <Button x:Name="ReplaceGlyphImageButton" Content="Replace image..." Click="ReplaceImageClick" IsEnabled="False" Margin="0,0,8,0"/>
            <Button Content="Remove selected" Click="RemoveImagesClick" Margin="0,0,8,0"/>
            <Button x:Name="AssignDigitsButton" Content="Assign 0–9 in this order" Click="AssignDigitsClick" ToolTip="Select exactly ten images in digit order, then use this button."/>
        </WrapPanel>
        <DataGrid x:Name="GlyphGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="GlyphSelectionChanged"
                  Background="{StaticResource Paper}" RowBackground="{StaticResource Panel}" AlternatingRowBackground="#302B25"
                  Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" GridLinesVisibility="None" RowHeight="64">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#3A342C"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="8"/></Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#4A4035"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Character" Width="95">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBox Text="{Binding Character, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Margin="8,14" VerticalContentAlignment="Center" TextAlignment="Center" ToolTip="The character represented by this image"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Image" Width="85">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Preview}" Width="56" Height="52" Stretch="Uniform"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" IsReadOnly="True" Width="*" MinWidth="240">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding Dimensions}" IsReadOnly="True" Width="90">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Background="#100E0C" Padding="10" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="FONT PREVIEW" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="FontPreview" Orientation="Horizontal" Height="50"/></ScrollViewer>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock x:Name="ValidationInfo" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="SavePngFontButton" Content="Save font..." Click="SaveFontClick" Margin="0,0,8,0"/>
                <Button x:Name="UsePngFontButton" Content="Use font" Click="UseFontClick" IsDefault="True"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
