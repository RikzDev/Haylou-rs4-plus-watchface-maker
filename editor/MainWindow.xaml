<Window x:Class="HaylouFaceEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de face RS4 Plus"
        Width="1180"
        Height="860"
        MinWidth="980"
        MinHeight="720"
        Background="{StaticResource Paper}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource Ink}" PreviewKeyDown="CanvasEscape"
        PreviewMouseLeftButtonDown="CanvasWindowMouseDown" PreviewMouseLeftButtonUp="CanvasWindowMouseUp"
        Deactivated="CanvasWindowDeactivated">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" FontSize="24" FontWeight="SemiBold" Text="RS4 Plus"/>
            <TextBlock DockPanel.Dock="Top" Margin="0,4,0,16" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap"
                       Text="Clique para selecionar. Arraste para mover e use as alças para redimensionar. Shift mantém a proporção; Esc cancela."/>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button x:Name="ImportButton" Content="Importar TBWF" Margin="0,0,0,8" Click="ImportClick"/>
                <Button x:Name="OpenButton" Content="Abrir projeto" Margin="0,0,0,8" Click="OpenClick"/>
                <Button x:Name="SaveProjectButton" Content="Salvar projeto" Margin="0,0,0,8" Click="SaveProjectClick"/>
                <Button x:Name="SaveBinButton" Content="Gerar .bin" Margin="0,0,0,8" Click="SaveBinClick"/>
                <Button x:Name="SendButton" Content="Enviar ao relógio" Margin="0,0,0,8" Click="SendClick"/>
                <Button x:Name="RecoveryButton" Content="Recovery (factory reset)" Click="RecoveryClick"/>
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Fontes e caracteres PNG são enviados como imagens para manter tamanho e posição."/>
            </StackPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Pacote" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                    <TextBlock Text="ID inicial: 253 · troca automática se ocupado" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Nome no arquivo (até 15 bytes)"/>
                    <TextBox x:Name="NameBox" Margin="0,4,0,8" Text="minha_face"/>
                    <TextBlock Text="Título no relógio"/>
                    <TextBox x:Name="TitleBox" Margin="0,4,0,0" Text="VS Code"/>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Sequências de imagens" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="AnimationInfo" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" Text="nenhuma"/>
                    </DockPanel>
                    <ListBox x:Name="AnimationList" Height="76" DisplayMemberPath="Label" SelectionChanged="AnimationSelected" Margin="0,0,0,8"/>
                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <Button x:Name="AddAnimationButton" Content="Sequência" Margin="0,0,3,0" Click="AddAnimationClick"/>
                        <Button x:Name="AddStaticImageButton" Content="Imagem fixa" Margin="3,0" Click="AddStaticImageClick"/>
                        <Button x:Name="RemoveAnimationButton" Content="Remover" Margin="3,0,0,0" Click="RemoveAnimationClick"/>
                    </UniformGrid>
                    <TextBlock Text="Nome"/>
                    <TextBox x:Name="AnimationNameBox" Margin="0,4,0,8" TextChanged="AnimationChanged"/>
                    <TextBlock Text="Modo"/>
                    <ComboBox x:Name="AnimationSourceBox" Margin="0,4,0,8" SelectionChanged="AnimationChanged"/>
                    <TextBlock Text="Prévia da sequência"/>
                    <UniformGrid Columns="2" Margin="0,4,0,6">
                        <ComboBox x:Name="AnimationPreviewModeBox" Margin="0,0,4,0" SelectionChanged="AnimationPreviewModeChanged">
                            <ComboBoxItem Tag="live" Content="Dados atuais"/>
                            <ComboBoxItem Tag="loop" Content="Reproduzir ciclo"/>
                            <ComboBoxItem Tag="frame" Content="Quadro no cursor"/>
                        </ComboBox>
                        <Button x:Name="AnimationPlayButton" Content="Pausar" Margin="4,0,0,0" Click="AnimationPlayClick"/>
                    </UniformGrid>
                    <Slider x:Name="AnimationFrameSlider" Minimum="0" Maximum="0" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="AnimationFrameSliderChanged"/>
                    <TextBlock x:Name="AnimationFrameInfo" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,8" Text="Selecione uma sequência"/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="X"/><TextBox x:Name="AnimationXBox" Margin="0,4,0,0" TextChanged="AnimationChanged"/></StackPanel>
                        <StackPanel><TextBlock Text="Y"/><TextBox x:Name="AnimationYBox" Margin="0,4,0,0" TextChanged="AnimationChanged"/></StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Largura"/><TextBox x:Name="AnimationWidthBox" Margin="0,4,0,0" TextChanged="AnimationChanged"/></StackPanel>
                        <StackPanel><TextBlock Text="Altura"/><TextBox x:Name="AnimationHeightBox" Margin="0,4,0,0" TextChanged="AnimationChanged"/></StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Intervalo (ms)"/>
                    <TextBox x:Name="AnimationIntervalBox" Margin="0,4,0,8" TextChanged="AnimationChanged"/>
                    <TextBlock Text="Quadros — clique para inspecionar ou ajustar"/>
                    <ListBox x:Name="FrameList" Height="148" SelectionChanged="FrameSelected" Margin="0,4,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="64" Margin="2" Padding="3" Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" ToolTip="{Binding FileName}">
                                    <StackPanel>
                                        <Image Source="{Binding Preview}" Width="56" Height="56" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Ajuste do quadro selecionado"/>
                    <UniformGrid Columns="2" Margin="0,4,0,8">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Deslocamento X"/><TextBox x:Name="FrameOffsetXBox" Margin="0,4,0,0" TextChanged="FrameOffsetChanged"/></StackPanel>
                        <StackPanel><TextBlock Text="Deslocamento Y"/><TextBox x:Name="FrameOffsetYBox" Margin="0,4,0,0" TextChanged="FrameOffsetChanged"/></StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button x:Name="AddFrameButton" Content="Adicionar quadros" Margin="0,0,4,4" Click="AddFramesToAnimationClick"/>
                        <Button x:Name="RemoveFrameButton" Content="Remover quadro" Margin="4,0,0,4" Click="RemoveFrameClick"/>
                        <Button x:Name="MoveFrameUpButton" Content="↑ Subir" Margin="0,4,4,0" Click="MoveFrameUpClick"/>
                        <Button x:Name="MoveFrameDownButton" Content="↓ Descer" Margin="4,4,0,0" Click="MoveFrameDownClick"/>
                    </UniformGrid>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Os modos escolhem um quadro a partir dos dados atuais. Bateria usa 0–100%; os demais usam o resto da divisão pela quantidade de quadros. Dia da semana segue domingo–sábado."/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="EDITOR DE FUNÇÕES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                            <TextBlock x:Name="SelectedName" FontSize="18" FontWeight="SemiBold" Text="Nenhum item selecionado" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Escolha a informação e ajuste o texto diretamente no mostrador ou pelos campos abaixo."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button x:Name="AddButton" Content="Novo texto" Margin="0,0,4,0" Click="AddClick"/>
                        <Button x:Name="RemoveButton" Content="Remover" Margin="4,0,0,0" Click="RemoveClick"/>
                    </UniformGrid>

                    <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="FONTE DE DADOS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="FunctionBox" Background="#332F29" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" Padding="8,5" SelectionChanged="FunctionChanged"/>
                            <TextBlock Text="Tempo, atividade e valores são atualizados no relógio." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock DockPanel.Dock="Left" Text="POSIÇÃO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                <TextBlock DockPanel.Dock="Right" Text="pixels · 368 × 448" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </DockPanel>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="X" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    <TextBox x:Name="XBox" Margin="0,3,0,0" TextChanged="CoordChanged"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <TextBlock Text="Y" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    <TextBox x:Name="YBox" Margin="0,3,0,0" TextChanged="CoordChanged"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="APARÊNCIA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                            <TextBlock Text="Fonte do texto" Foreground="{StaticResource Muted}" FontSize="11"/>
                            <ComboBox x:Name="FontChoiceBox" Margin="0,3,0,7" SelectionChanged="FontChoiceChanged"/>
                            <Button x:Name="LoadFontButton" Content="Carregar fonte (.ttf / .otf)" Margin="0,0,0,10" Click="LoadFontClick"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Tamanho" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    <TextBox x:Name="SizeBox" Margin="0,3,0,0" TextChanged="FontSizeChanged"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <TextBlock Text="Cor #RRGGBB" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    <TextBox x:Name="ColorBox" Margin="0,3,0,0" TextChanged="ColorChanged"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="CharacterInfo" Text="Texto com fonte." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <TextBlock Text="Espaço entre caracteres (px)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
                            <TextBox x:Name="CharacterSpacingBox" Text="0" IsEnabled="False" Margin="0,3,0,0" TextChanged="CharacterSpacingChanged"/>
                            <TextBlock Text="Positivo afasta os caracteres; negativo aproxima."
                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="A prévia usa os mesmos caracteres e posições enviados ao relógio."
                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="AMOSTRA OU TEXTO FIXO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <TextBox x:Name="SampleBox" MaxLength="12" ToolTip="Até 12 caracteres por texto" TextChanged="SampleChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DockPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="#100E0C" CornerRadius="18" Padding="24">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="Watch" Width="368" Height="448" Background="Black" ClipToBounds="True">
                    <Image x:Name="BackgroundImage" Width="368" Height="448" Stretch="Fill"/>
                    <Canvas x:Name="Overlay" Width="368" Height="448" Background="Transparent"
                            MouseMove="CanvasMouseMove" MouseLeftButtonUp="CanvasMouseUp"
                            MouseLeftButtonDown="CanvasBackgroundMouseDown" LostMouseCapture="CanvasLostMouseCapture"
                            MouseLeave="CanvasMouseLeave"/>
                    <Canvas x:Name="ManipulationLayer" Width="368" Height="448"/>
                </Grid>
            </Viewbox>
        </Border>

        <DockPanel Grid.Column="2" Margin="16,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Saída" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox x:Name="LogBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                     Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
                     BorderBrush="{StaticResource Line}" Padding="8"/>
        </DockPanel>
    </Grid>
</Window>
