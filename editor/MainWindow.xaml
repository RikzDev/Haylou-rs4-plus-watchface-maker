<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="HaylouFaceEditor.MainWindow" Title="RS4 Studio - Watchface Editor" Width="1500" Height="980" MinWidth="1120" MinHeight="760" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="12" PreviewKeyDown="StudioKeyDown" PreviewMouseLeftButtonDown="CanvasWindowMouseDown" PreviewMouseLeftButtonUp="CanvasWindowMouseUp" Deactivated="CanvasWindowDeactivated">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="RS4 STUDIO" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="15,0,25,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="DESIGN WORKSPACE" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Menu x:Name="StudioMenu" Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="Open project..." InputGestureText="Ctrl+O" Click="OpenClick" />
                        <MenuItem Header="Import TBWF..." InputGestureText="Ctrl+I" Click="ImportClick" />
                        <Separator />
                        <MenuItem Header="Save project..." InputGestureText="Ctrl+S" Click="SaveProjectClick" />
                        <MenuItem Header="Generate binary..." InputGestureText="Ctrl+Shift+B" Click="SaveBinClick" />
                    </MenuItem>
                    <MenuItem Header="_Add">
                        <MenuItem Header="Text" Click="AddClick" />
                        <MenuItem Header="Fixed image..." Click="AddStaticImageClick" />
                        <MenuItem Header="Image sequence..." Click="AddAnimationClick" />
                        <MenuItem Header="Built-in icons..." Click="OpenIconLibraryClick" />
                        <MenuItem Header="Weather icons..." Click="OpenWeatherIconsClick" />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="Fit artboard" Click="FitArtboardClick" />
                        <MenuItem Header="Timeline" Click="ShowTimelineClick" />
                        <MenuItem Header="Output" Click="ShowOutputClick" />
                        <MenuItem Header="Background properties" Click="SelectBackgroundClick" />
                        <Separator />
                        <MenuItem Header="Reset panel layout" Click="ResetStudioLayoutClick" />
                    </MenuItem>
                    <MenuItem Header="_Watch">
                        <MenuItem Header="Send to watch..." Click="SendClick" />
                        <Separator />
                        <MenuItem x:Name="RecoveryButton" Header="Recovery (factory reset)..." Click="RecoveryClick" />
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel x:Name="StudioToolbar" Margin="10,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveBinButton" Content="Build .bin" Style="{StaticResource StudioToolButton}" Click="SaveBinClick" ToolTip="Generate watchface binary (Ctrl+Shift+B)" Margin="0,0,6,0" />
                    <Button x:Name="SendButton" Content="Send to watch" Style="{StaticResource StudioAccentButton}" Click="SendClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenButton" Content="Open" Style="{StaticResource StudioToolButton}" Click="OpenClick" ToolTip="Open project (Ctrl+O)" />
                    <Button x:Name="ImportButton" Content="Import TBWF" Style="{StaticResource StudioToolButton}" Click="ImportClick" Margin="4,0,0,0" />
                    <Button x:Name="SaveProjectButton" Content="Save" Style="{StaticResource StudioToolButton}" Click="SaveProjectClick" ToolTip="Save project (Ctrl+S)" Margin="4,0,0,0" />
                    <Border Width="1" Background="{StaticResource Line}" Margin="12,2" />
                    <Button x:Name="AddButton" Content="+ Text" Style="{StaticResource StudioToolButton}" Click="AddClick" />
                    <Button Content="+ Image" Style="{StaticResource StudioToolButton}" Click="AddStaticImageClick" Margin="4,0,0,0" />
                    <Button Content="+ Sequence" Style="{StaticResource StudioToolButton}" Click="AddAnimationClick" Margin="4,0,0,0" />
                    <Button x:Name="IconLibraryButton" Content="Icon library" Style="{StaticResource StudioToolButton}" Click="OpenIconLibraryClick" Margin="4,0,0,0" />
                    <Button x:Name="WeatherIconsButton" Content="Weather icons" Style="{StaticResource StudioToolButton}" Click="OpenWeatherIconsClick" Margin="4,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2" x:Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition x:Name="ExplorerColumn" Width="244" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="InspectorColumn" Width="328" MinWidth="285" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="290" />
                <RowDefinition Height="5" />
                <RowDefinition x:Name="TimelineRow" Height="270" MinHeight="210" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <StackPanel Margin="3,8">
                    <Button Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource StudioRailButton}" ToolTip="Project explorer" Click="ShowExplorerClick" />
                    <Button Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource StudioRailButton}" ToolTip="Image and sequence assets" Click="ShowAssetsClick" Margin="0,8,0,0" />
                    <Button Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource StudioRailButton}" ToolTip="Background properties" Click="SelectBackgroundClick" Margin="0,8,0,0" />
                    <Button Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource StudioRailButton}" ToolTip="Animation timeline" Click="ShowTimelineClick" Margin="0,8,0,0" />
                    <Button Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource StudioRailButton}" ToolTip="Output" Click="ShowOutputClick" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <TextBlock Text="PROJECT EXPLORER" Style="{StaticResource StudioPaneTitle}" />
                    </Border>
                    <TabControl x:Name="ExplorerTabs">
                        <TabItem Header="Layers">
                            <Grid Margin="9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Content="Background" Click="SelectBackgroundClick" HorizontalContentAlignment="Left" Style="{StaticResource StudioToolButton}" Margin="0,0,0,8" ToolTip="Edit the artboard background" />
                                <ListBox x:Name="LayerList" Grid.Row="1" SelectionChanged="LayerSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="1,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Kind}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ZIndex}" Foreground="{StaticResource Muted}" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <TextBlock Text="Z-index" Style="{StaticResource StudioFieldLabel}" />
                                    <TextBox x:Name="LayerZIndexBox" TextChanged="LayerZIndexChanged" Margin="0,4,0,8" />
                                    <UniformGrid Columns="2">
                                        <Button x:Name="BringToFrontButton" Content="To front" Style="{StaticResource StudioToolButton}" Click="BringToFrontClick" Margin="0,0,3,0" />
                                        <Button x:Name="SendToBackButton" Content="To back" Style="{StaticResource StudioToolButton}" Click="SendToBackClick" Margin="3,0,0,0" />
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Assets">
                            <DockPanel Margin="9">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="IMAGES / SEQUENCES" Style="{StaticResource StudioPaneTitle}" />
                                    <TextBlock x:Name="AnimationInfo" Text="none" Foreground="{StaticResource Muted}" Margin="6,0,0,0" />
                                </DockPanel>
                                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                                    <Button x:Name="AddAnimationButton" Content="Sequence" Click="AddAnimationClick" Style="{StaticResource StudioSmallButton}" Margin="0,0,2,0" />
                                    <Button x:Name="AddStaticImageButton" Content="Image" Click="AddStaticImageClick" Style="{StaticResource StudioSmallButton}" Margin="2,0" />
                                    <Button x:Name="RemoveAnimationButton" Content="Remove" Click="RemoveAnimationClick" Style="{StaticResource StudioSmallButton}" Margin="2,0,0,0" />
                                </UniformGrid>
                                <ListBox x:Name="AnimationList" SelectionChanged="AnimationSelected" DisplayMemberPath="Label" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Package">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12">
                                    <TextBlock Text="WATCHFACE PACKAGE" Style="{StaticResource StudioPaneTitle}" Margin="0,0,0,14" />
                                    <TextBlock Text="Package name" Style="{StaticResource StudioFieldLabel}" />
                                    <TextBox x:Name="NameBox" Text="my_face" Margin="0,4,0,12" />
                                    <TextBlock Text="Watch title" Style="{StaticResource StudioFieldLabel}" />
                                    <TextBox x:Name="TitleBox" Text="My face" Margin="0,4,0,16" />
                                    <TextBlock Text="Haylou RS4 Plus / LS11" />
                                    <TextBlock Text="368 x 448 pixels" Foreground="{StaticResource Muted}" Margin="0,4,0,16" />
                                    <TextBlock Text="Starting ID: 253. Upload automatically tries another validated slot if occupied." Style="{StaticResource StudioHelp}" />
                                    <TextBlock Text="Fonts and PNG characters are rasterized to preserve their appearance and position." Style="{StaticResource StudioHelp}" Margin="0,12,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Paper}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border BorderBrush="{StaticResource Accent}" BorderThickness="0,2,0,0" Background="{StaticResource Paper}" Padding="14,7">
                            <TextBlock x:Name="StudioDocumentTitle" Text="my_face / Design" />
                        </Border>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource Panel}">
                    <DockPanel Margin="10,4">
                        <TextBlock Text="ARTBOARD" Style="{StaticResource StudioPaneTitle}" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Fit" Click="FitArtboardClick" Style="{StaticResource StudioSmallButton}" />
                            <Button Content="-" Click="ZoomOutClick" Style="{StaticResource StudioSmallButton}" Margin="8,0,2,0" />
                            <TextBlock x:Name="StudioZoomLabel" Text="100%" Width="46" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                            <Button Content="+" Click="ZoomInClick" Style="{StaticResource StudioSmallButton}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="ArtboardScroll" Grid.Row="2" Background="#100E0C" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="ArtboardViewportChanged" PreviewMouseWheel="ArtboardMouseWheel">
                    <Grid MinWidth="{Binding ViewportWidth, ElementName=ArtboardScroll}" MinHeight="{Binding ViewportHeight, ElementName=ArtboardScroll}">
                        <Viewbox x:Name="WatchViewbox" Width="368" Height="448" Stretch="Uniform" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid x:Name="Watch" Width="368" Height="448" Background="Black" ClipToBounds="True">
                                <Image x:Name="BackgroundImage" Width="368" Height="448" Stretch="Fill" />
                                <Canvas x:Name="Overlay" Width="368" Height="448" Background="Transparent" MouseMove="CanvasMouseMove" MouseLeftButtonUp="CanvasMouseUp" MouseLeftButtonDown="CanvasBackgroundMouseDown" LostMouseCapture="CanvasLostMouseCapture" MouseLeave="CanvasMouseLeave" />
                                <Canvas x:Name="ManipulationLayer" Width="368" Height="448" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ScrollViewer>
                <Border Grid.Row="3" Background="{StaticResource Panel}">
                    <TextBlock Text="368 x 448 px  |  Drag to move  |  Shift: keep proportions  |  Esc: cancel" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <GridSplitter Grid.Column="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Paper}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
            <Border Grid.Column="5" Background="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="INSPECTOR" Style="{StaticResource StudioPaneTitle}" />
                            <TextBlock x:Name="StudioInspectorType" Text="Background" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                    <TabControl x:Name="InspectorTabs" SelectionChanged="InspectorTabChanged">
                        <TabItem Header="Text">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12">
                                    <Button x:Name="RemoveButton" Content="Remove text" HorizontalAlignment="Right" Click="RemoveClick" Style="{StaticResource StudioSmallButton}" Margin="0,0,0,8" />
                                    <StackPanel x:Name="TextPropertiesPanel">
                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="ELEMENT EDITOR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                                <TextBlock x:Name="SelectedName" FontSize="18" FontWeight="SemiBold" Text="No element selected" TextTrimming="CharacterEllipsis" MaxWidth="270" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="Element name" Style="{StaticResource StudioFieldLabel}" />
                                        <TextBox x:Name="TextElementNameBox" MaxLength="80" TextChanged="TextElementNameChanged" LostFocus="TextElementNameLostFocus" Margin="0,4,0,12" ToolTip="Changes the name in Layers. The displayed text and data source stay unchanged." />
                                        <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="DATA SOURCE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                                <ComboBox x:Name="FunctionBox" Background="#332F29" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" Padding="8,5" SelectionChanged="FunctionChanged" />
                                                <TextBlock Text="Time, activity and values update on the watch." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,7">
                                                    <TextBlock DockPanel.Dock="Left" Text="POSITION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="pixels · 368 × 448" FontSize="11" Foreground="{StaticResource Muted}" />
                                                </DockPanel>
                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,5,0">
                                                        <TextBlock Text="X" Foreground="{StaticResource Muted}" FontSize="11" />
                                                        <TextBox x:Name="XBox" Margin="0,3,0,0" TextChanged="CoordChanged" />
                                                    </StackPanel>
                                                    <StackPanel Margin="5,0,0,0">
                                                        <TextBlock Text="Y" Foreground="{StaticResource Muted}" FontSize="11" />
                                                        <TextBox x:Name="YBox" Margin="0,3,0,0" TextChanged="CoordChanged" />
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
                                                <TextBlock Text="Text font" Foreground="{StaticResource Muted}" FontSize="11" />
                                                <ComboBox x:Name="FontChoiceBox" Margin="0,3,0,7" SelectionChanged="FontChoiceChanged" />
                                                <Button x:Name="LoadFontButton" Content="Load font (.ttf / .otf)" Margin="0,0,0,10" Click="LoadFontClick" />
                                                <Button x:Name="LoadPngFontButton" Content="Load PNG font..." Margin="0,0,0,10" Click="LoadPngFontClick" ToolTip="Choose PNG character images to create a font, or open a saved .hfont.json font." />
                                                <Button x:Name="EditPngFontButton" Content="Edit PNG font..." Margin="0,0,0,10" Click="EditPngFontClick" ToolTip="Add characters, replace images or change the mapping of this PNG font. Updates all text elements using it." />
                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,5,0">
                                                        <TextBlock Text="Size" Foreground="{StaticResource Muted}" FontSize="11" />
                                                        <TextBox x:Name="SizeBox" Margin="0,3,0,0" TextChanged="FontSizeChanged" />
                                                    </StackPanel>
                                                    <StackPanel Margin="5,0,0,0">
                                                        <TextBlock Text="Color #RRGGBB" Foreground="{StaticResource Muted}" FontSize="11" />
                                                        <TextBox x:Name="ColorBox" Margin="0,3,0,0" TextChanged="ColorChanged" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock x:Name="CharacterInfo" Text="Font text." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                                <TextBlock Text="Character spacing (px)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" />
                                                <TextBox x:Name="CharacterSpacingBox" Text="0" IsEnabled="False" Margin="0,3,0,0" TextChanged="CharacterSpacingChanged" />
                                                <TextBlock Text="Positive values separate characters; negative values bring them closer." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="The preview uses the same characters and positions exported to the watch." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="SAMPLE OR FIXED TEXT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                                <TextBox x:Name="SampleBox" MaxLength="12" ToolTip="Up to 12 characters per text element" TextChanged="SampleChanged" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Image / Sequence">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ImagePropertiesPanel" Margin="12">
                                    <TextBlock Text="Name" Style="{StaticResource StudioFieldLabel}" />
                                    <TextBox x:Name="AnimationNameBox" TextChanged="AnimationChanged" Margin="0,4,0,12" />
                                    <Expander Header="Transform" IsExpanded="True" Margin="0,0,0,12">
                                        <StackPanel Margin="0,10,0,0">
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,5,0">
                                                    <TextBlock Text="X" Style="{StaticResource StudioFieldLabel}" />
                                                    <TextBox x:Name="AnimationXBox" TextChanged="AnimationChanged" Margin="0,4,0,8" />
                                                </StackPanel>
                                                <StackPanel Margin="5,0,0,0">
                                                    <TextBlock Text="Y" Style="{StaticResource StudioFieldLabel}" />
                                                    <TextBox x:Name="AnimationYBox" TextChanged="AnimationChanged" Margin="0,4,0,8" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,5,0">
                                                    <TextBlock Text="Width" Style="{StaticResource StudioFieldLabel}" />
                                                    <TextBox x:Name="AnimationWidthBox" TextChanged="AnimationChanged" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="5,0,0,0">
                                                    <TextBlock Text="Height" Style="{StaticResource StudioFieldLabel}" />
                                                    <TextBox x:Name="AnimationHeightBox" TextChanged="AnimationChanged" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>
                                    <Expander Header="Data and playback" IsExpanded="True" Margin="0,0,0,12">
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="Mode" Style="{StaticResource StudioFieldLabel}" />
                                            <ComboBox x:Name="AnimationSourceBox" SelectionChanged="AnimationChanged" Margin="0,4,0,12" />
                                            <StackPanel x:Name="WeatherSequenceOptions" Visibility="Collapsed" Margin="0,0,0,12">
                                                <Button Content="Edit weather icons..." Click="OpenWeatherIconsClick" Style="{StaticResource StudioToolButton}" />
                                                <TextBlock Text="16 fixed condition slots. Uses phone-synchronized weather; no data selects the fallback icon. Replace icons in the weather panel." Style="{StaticResource StudioHelp}" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <StackPanel x:Name="AnimationRangePanel" Visibility="Collapsed" Margin="0,0,0,12">
                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,5,0">
                                                        <TextBlock x:Name="AnimationMinLabel" Text="Minimum" Style="{StaticResource StudioFieldLabel}" />
                                                        <TextBox x:Name="AnimationMinBox" TextChanged="AnimationChanged" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Margin="5,0,0,0">
                                                        <TextBlock x:Name="AnimationMaxLabel" Text="Maximum" Style="{StaticResource StudioFieldLabel}" />
                                                        <TextBox x:Name="AnimationMaxBox" TextChanged="AnimationChanged" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock x:Name="AnimationRangeInfo" Style="{StaticResource StudioHelp}" Margin="0,6,0,0" />
                                                <TextBlock x:Name="AnimationRangeError" Foreground="Gold" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                                            </StackPanel>
                                            <TextBlock Text="Frame interval (ms)" Style="{StaticResource StudioFieldLabel}" />
                                            <TextBox x:Name="AnimationIntervalBox" TextChanged="AnimationChanged" Margin="0,4,0,4" />
                                            <TextBlock Text="Time-based loops advance on 200 ms ticks. Data modes select frames from the watch value." Style="{StaticResource StudioHelp}" />
                                        </StackPanel>
                                    </Expander>
                                    <Expander Header="Appearance" IsExpanded="True">
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="Icon / image color" Style="{StaticResource StudioFieldLabel}" />
                                            <DockPanel Margin="0,4,0,8">
                                                <Button Content="Original" DockPanel.Dock="Right" Click="ResetAnimationColorClick" Style="{StaticResource StudioSmallButton}" Margin="6,0,0,0" />
                                                <TextBox x:Name="AnimationColorBox" TextChanged="AnimationColorChanged" ToolTip="#RRGGBB or #AARRGGBB. Blank restores original colors." />
                                            </DockPanel>
                                            <UniformGrid Columns="6">
                                                <Button Tag="#FFFFFF" Background="White" Height="20" Margin="0,0,3,0" Click="AnimationColorSwatchClick" />
                                                <Button Tag="#000000" Background="Black" Height="20" Margin="0,0,3,0" Click="AnimationColorSwatchClick" />
                                                <Button Tag="#FF4444" Background="#FF4444" Height="20" Margin="0,0,3,0" Click="AnimationColorSwatchClick" />
                                                <Button Tag="#FFD54F" Background="#FFD54F" Height="20" Margin="0,0,3,0" Click="AnimationColorSwatchClick" />
                                                <Button Tag="#66BB6A" Background="#66BB6A" Height="20" Margin="0,0,3,0" Click="AnimationColorSwatchClick" />
                                                <Button Tag="#42A5F5" Background="#42A5F5" Height="20" Click="AnimationColorSwatchClick" />
                                            </UniformGrid>

                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Background">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12">
                                    <StackPanel x:Name="BackgroundEditorPanel">
                                        <TextBlock Text="Background" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock x:Name="BackgroundFileInfo" Text="Solid color · 368 × 448" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8" />
                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <Button Content="Change image..." Click="ChooseBackgroundClick" Margin="0,0,4,0" />
                                            <Button x:Name="RemoveBackgroundButton" Content="Remove image" Click="RemoveBackgroundClick" Margin="4,0,0,0" />
                                        </UniformGrid>
                                        <TextBlock Text="Fill color" />
                                        <DockPanel Margin="0,4,0,8">
                                            <Button DockPanel.Dock="Right" Tag="#FFFFFF" Background="White" Width="28" Margin="6,0,0,0" Click="BackgroundColorSwatchClick" ToolTip="White" />
                                            <Button DockPanel.Dock="Right" Tag="#000000" Background="Black" Width="28" Margin="6,0,0,0" Click="BackgroundColorSwatchClick" ToolTip="Black" />
                                            <TextBox x:Name="BackgroundColorBox" TextChanged="BackgroundColorChanged" ToolTip="#RRGGBB. Also fills transparent pixels and empty space around the image." />
                                        </DockPanel>
                                        <TextBlock Text="Image fit" />
                                        <ComboBox x:Name="BackgroundFitBox" SelectionChanged="BackgroundFitChanged" Margin="0,4,0,8">
                                            <ComboBoxItem Tag="cover" Content="Fill screen (crop)" />
                                            <ComboBoxItem Tag="fit" Content="Fit whole image" />
                                            <ComboBoxItem Tag="stretch" Content="Stretch to screen" />
                                            <ComboBoxItem Tag="center" Content="Original size" />
                                        </ComboBox>
                                        <TextBlock x:Name="BackgroundZoomInfo" Text="Zoom · 100%" />
                                        <Slider x:Name="BackgroundZoomSlider" Minimum="10" Maximum="400" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BackgroundZoomChanged" Margin="0,4,0,8" />
                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="X offset" />
                                                <TextBox x:Name="BackgroundXBox" Margin="0,4,0,0" TextChanged="BackgroundPositionChanged" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Y offset" />
                                                <TextBox x:Name="BackgroundYBox" Margin="0,4,0,0" TextChanged="BackgroundPositionChanged" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <Button x:Name="ResetBackgroundPlacementButton" Content="Reset placement" Click="ResetBackgroundPlacementClick" />
                                        <TextBlock Text="Live preview. The background stays below all elements." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Paper}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
            <TabControl x:Name="StudioBottomTabs" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5">
                <TabItem Header="Timeline">
                    <Grid x:Name="StudioTimeline" Background="{StaticResource Panel}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="38" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="9,4" LastChildFill="False">
                            <Button x:Name="TimelineFirstButton" Content="|&lt;" Click="FirstTimelineFrameClick" Style="{StaticResource StudioSmallButton}" ToolTip="First frame (Home)" />
                            <Button x:Name="TimelinePreviousButton" Content="&lt;" Click="PreviousTimelineFrameClick" Style="{StaticResource StudioSmallButton}" ToolTip="Previous frame (Left)" Margin="3,0" />
                            <Button x:Name="AnimationPlayButton" Content="Play" Click="AnimationPlayClick" Style="{StaticResource StudioAccentButton}" Width="66" ToolTip="Play or pause loop preview (Space)" />
                            <Button x:Name="TimelineNextButton" Content="&gt;" Click="NextTimelineFrameClick" Style="{StaticResource StudioSmallButton}" ToolTip="Next frame (Right)" Margin="3,0" />
                            <Button x:Name="TimelineRestartButton" Content="Restart" Click="RestartTimelineClick" Style="{StaticResource StudioSmallButton}" Margin="4,0,12,0" />
                            <TextBlock x:Name="TimelineClock" Text="00:00.000" FontFamily="Consolas" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="AnimationPreviewModeBox" Width="132" SelectionChanged="AnimationPreviewModeChanged" Margin="0,0,12,0">
                                <ComboBoxItem Tag="live" Content="Live data" />
                                <ComboBoxItem Tag="loop" Content="Play loop" />
                                <ComboBoxItem Tag="frame" Content="Single frame" />
                            </ComboBox>
                            <TextBlock x:Name="AnimationFrameInfo" Text="Select a sequence" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="Scale" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,5,0" />
                                <Slider x:Name="TimelineScaleSlider" Width="86" Minimum="60" Maximum="180" Value="100" ValueChanged="TimelineScaleChanged" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="9,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="204" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="0,0,6,0">
                                <TextBlock DockPanel.Dock="Top" Text="TRACKS" Style="{StaticResource StudioPaneTitle}" Margin="8,4,0,7" />
                                <ListBox x:Name="TimelineTrackList" SelectionChanged="TimelineTrackSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3,4">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <Grid Grid.Column="1" Background="{StaticResource Paper}">
                                <TextBlock x:Name="TimelineEmptyState" Text="Add an image sequence or select a track to edit its frames." Foreground="{StaticResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" />
                                <ScrollViewer x:Name="TimelineFrameScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <Grid x:Name="TimelineFilmstrip" HorizontalAlignment="Left">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Canvas x:Name="TimelineRuler" Height="26" Background="Transparent" MouseLeftButtonDown="TimelineRulerDown" MouseMove="TimelineRulerMove" MouseLeftButtonUp="TimelineRulerUp" LostMouseCapture="TimelineRulerLostCapture" />
                                        <ListBox x:Name="FrameList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="FrameSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AllowDrop="True" PreviewMouseLeftButtonDown="TimelineFrameMouseDown" PreviewMouseMove="TimelineFrameMouseMove" DragOver="TimelineFrameDragOver" Drop="TimelineFrameDrop">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource StudioListItem}">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding TimelineWidth}" Padding="5" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" ToolTip="{Binding FileName}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" MinHeight="38" />
                                                                <RowDefinition Height="22" />
                                                            </Grid.RowDefinitions>
                                                            <Image Source="{Binding Preview}" Stretch="Uniform" MaxHeight="64" />
                                                            <DockPanel Grid.Row="1" Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Ink}" FontSize="10" />
                                                                <TextBlock Text="{Binding DurationLabel}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Canvas Grid.RowSpan="2" x:Name="TimelineCursorCanvas" IsHitTestVisible="False" ClipToBounds="True">
                                            <Line x:Name="TimelineCursor" Stroke="{StaticResource Accent}" StrokeThickness="2" Y1="0" Y2="190" />
                                        </Canvas>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                        <DockPanel Grid.Row="2" Margin="9,4" LastChildFill="False">
                            <TextBlock Text="FRAME OFFSET" Style="{StaticResource StudioPaneTitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="X" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="FrameOffsetXBox" Width="48" TextChanged="FrameOffsetChanged" />
                            <TextBlock Text="Y" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,4,0" />
                            <TextBox x:Name="FrameOffsetYBox" Width="48" TextChanged="FrameOffsetChanged" Margin="0,0,12,0" />
                            <Button x:Name="AddFrameButton" Content="Add frames" Click="AddFramesToAnimationClick" Style="{StaticResource StudioSmallButton}" Margin="0,0,4,0" />
                            <Button x:Name="AddLibraryFramesButton" Content="Add icons" Click="OpenIconLibraryClick" Style="{StaticResource StudioSmallButton}" Margin="0,0,4,0" />
                            <Button x:Name="RemoveFrameButton" Content="Remove" Click="RemoveFrameClick" Style="{StaticResource StudioSmallButton}" Margin="0,0,10,0" />
                            <Button x:Name="MoveFrameUpButton" Content="Move left" Click="MoveFrameUpClick" Style="{StaticResource StudioSmallButton}" Margin="0,0,4,0" />
                            <Button x:Name="MoveFrameDownButton" Content="Move right" Click="MoveFrameDownClick" Style="{StaticResource StudioSmallButton}" />
                            <Slider x:Name="AnimationFrameSlider" Width="120" Margin="12,0,0,0" Minimum="0" Maximum="0" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="AnimationFrameSliderChanged" VerticalAlignment="Center" ToolTip="Scrub frame" />
                        </DockPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Output">
                    <Grid Margin="10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button Content="Clear" DockPanel.Dock="Right" Click="ClearOutputClick" Style="{StaticResource StudioSmallButton}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="INFO" Foreground="White" FontSize="10" Margin="0,0,16,0" />
                                <TextBlock Text="WARNING" Foreground="Gold" FontSize="10" Margin="0,0,16,0" />
                                <TextBlock Text="ERROR" Foreground="Red" FontSize="10" Margin="0,0,16,0" />
                                <TextBlock Text="UPLOAD NOTE" Foreground="DeepSkyBlue" FontSize="10" />
                            </StackPanel>
                        </DockPanel>
                        <RichTextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" BorderThickness="0" Padding="8">
                            <FlowDocument PagePadding="0" />
                        </RichTextBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource Line}">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="StudioStatus" Text="Ready" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock DockPanel.Dock="Right" Text="LS11   |   368 x 448   |   Studio workspace" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="10" HorizontalAlignment="Right" Margin="16,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
