<Window x:Class="HaylouFaceEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RS4 Plus Watchface Editor"
        Width="1180"
        Height="860"
        MinWidth="980"
        MinHeight="720"
        Background="{StaticResource Paper}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource Ink}" PreviewKeyDown="CanvasEscape"
        PreviewMouseLeftButtonDown="CanvasWindowMouseDown" PreviewMouseLeftButtonUp="CanvasWindowMouseUp"
        Deactivated="CanvasWindowDeactivated">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" FontSize="24" FontWeight="SemiBold" Text="RS4 Plus"/>
            <TextBlock DockPanel.Dock="Top" Margin="0,4,0,16" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap"
                       Text="Click to select. Drag to move and use the handles to resize. Shift keeps proportions; Esc cancels."/>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button x:Name="ImportButton" Content="Import TBWF" Margin="0,0,0,8" Click="ImportClick"/>
                <Button x:Name="IconLibraryButton" Content="Icon library" Margin="0,0,0,8" Click="OpenIconLibraryClick" ToolTip="Browse the built-in icons and add an icon or sequence."/>
                <Button x:Name="OpenButton" Content="Open project" Margin="0,0,0,8" Click="OpenClick"/>
                <Button x:Name="SaveProjectButton" Content="Save project" Margin="0,0,0,8" Click="SaveProjectClick"/>
                <Button x:Name="SaveBinButton" Content="Generate .bin" Margin="0,0,0,8" Click="SaveBinClick"/>
                <Button x:Name="SendButton" Content="Send to watch" Margin="0,0,0,8" Click="SendClick"/>
                <Button x:Name="RecoveryButton" Content="Recovery (factory reset)" Click="RecoveryClick"/>
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Fonts and PNG characters are exported as images to preserve size and position."/>
            </StackPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel x:Name="BackgroundEditorPanel">
                    <TextBlock Text="Background" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="BackgroundFileInfo" Text="Solid color · 368 × 448" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="Change image..." Click="ChooseBackgroundClick" Margin="0,0,4,0"/>
                        <Button x:Name="RemoveBackgroundButton" Content="Remove image" Click="RemoveBackgroundClick" Margin="4,0,0,0"/>
                    </UniformGrid>
                    <TextBlock Text="Fill color"/>
                    <DockPanel Margin="0,4,0,8">
                        <Button DockPanel.Dock="Right" Tag="#FFFFFF" Background="White" Width="28" Margin="6,0,0,0" Click="BackgroundColorSwatchClick" ToolTip="White"/>
                        <Button DockPanel.Dock="Right" Tag="#000000" Background="Black" Width="28" Margin="6,0,0,0" Click="BackgroundColorSwatchClick" ToolTip="Black"/>
                        <TextBox x:Name="BackgroundColorBox" TextChanged="BackgroundColorChanged" ToolTip="#RRGGBB. Also fills transparent pixels and empty space around the image."/>
                    </DockPanel>
                    <TextBlock Text="Image fit"/>
                    <ComboBox x:Name="BackgroundFitBox" SelectionChanged="BackgroundFitChanged" Margin="0,4,0,8">
                        <ComboBoxItem Tag="cover" Content="Fill screen (crop)"/>
                        <ComboBoxItem Tag="fit" Content="Fit whole image"/>
                        <ComboBoxItem Tag="stretch" Content="Stretch to screen"/>
                        <ComboBoxItem Tag="center" Content="Original size"/>
                    </ComboBox>
                    <TextBlock x:Name="BackgroundZoomInfo" Text="Zoom · 100%"/>
                    <Slider x:Name="BackgroundZoomSlider" Minimum="10" Maximum="400" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BackgroundZoomChanged" Margin="0,4,0,8"/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,4,0"><TextBlock Text="X offset"/><TextBox x:Name="BackgroundXBox" Margin="0,4,0,0" TextChanged="BackgroundPositionChanged"/></StackPanel>
                        <StackPanel Margin="4,0,0,0"><TextBlock Text="Y offset"/><TextBox x:Name="BackgroundYBox" Margin="0,4,0,0" TextChanged="BackgroundPositionChanged"/></StackPanel>
                    </UniformGrid>
                    <Button x:Name="ResetBackgroundPlacementButton" Content="Reset placement" Click="ResetBackgroundPlacementClick"/>
                    <TextBlock Text="Live preview. The background stays below all elements." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Package" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                    <TextBlock Text="Starting ID: 253 · switches automatically if occupied" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Package name (up to 15 bytes)"/>
                    <TextBox x:Name="NameBox" Margin="0,4,0,8" Text="my_face"/>
                    <TextBlock Text="Watch title"/>
                    <TextBox x:Name="TitleBox" Margin="0,4,0,0" Text="My face"/>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Image sequences" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="AnimationInfo" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" Text="none" TextAlignment="Right" Margin="8,0,0,0"/>
                    </DockPanel>
                    <ListBox x:Name="AnimationList" Height="76" DisplayMemberPath="Label" SelectionChanged="AnimationSelected" Margin="0,0,0,8"/>
                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <Button x:Name="AddAnimationButton" Content="Sequence" Margin="0,0,3,0" Click="AddAnimationClick"/>
                        <Button x:Name="AddStaticImageButton" Content="Image" ToolTip="Add a fixed image" Margin="3,0" Click="AddStaticImageClick"/>
                        <Button x:Name="RemoveAnimationButton" Content="Remove" Margin="3,0,0,0" Click="RemoveAnimationClick"/>
                    </UniformGrid>
                    <TextBlock Text="Name"/>
                    <TextBox x:Name="AnimationNameBox" Margin="0,4,0,8" TextChanged="AnimationChanged"/>
                    <TextBlock Text="Icon / image color"/>
                    <DockPanel Margin="0,4,0,6">
                        <Button DockPanel.Dock="Right" Content="Original" Margin="6,0,0,0" Padding="8,4" Click="ResetAnimationColorClick" ToolTip="Restore the original colors"/>
                        <TextBox x:Name="AnimationColorBox" TextChanged="AnimationColorChanged" ToolTip="#RRGGBB or #AARRGGBB. Leave blank for the original colors."/>
                    </DockPanel>
                    <UniformGrid Columns="6" Margin="0,0,0,5">
                        <Button Tag="#FFFFFF" Background="White" Height="22" Margin="0,0,3,0" ToolTip="White" Click="AnimationColorSwatchClick"/>
                        <Button Tag="#000000" Background="Black" Height="22" Margin="0,0,3,0" ToolTip="Black" Click="AnimationColorSwatchClick"/>
                        <Button Tag="#FF4444" Background="#FF4444" Height="22" Margin="0,0,3,0" ToolTip="Red" Click="AnimationColorSwatchClick"/>
                        <Button Tag="#FFD54F" Background="#FFD54F" Height="22" Margin="0,0,3,0" ToolTip="Yellow" Click="AnimationColorSwatchClick"/>
                        <Button Tag="#66BB6A" Background="#66BB6A" Height="22" Margin="0,0,3,0" ToolTip="Green" Click="AnimationColorSwatchClick"/>
                        <Button Tag="#42A5F5" Background="#42A5F5" Height="22" ToolTip="Blue" Click="AnimationColorSwatchClick"/>
                    </UniformGrid>
                    <TextBlock Text="HEX color; applies to every frame. Original restores the source artwork." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Mode"/>
                    <ComboBox x:Name="AnimationSourceBox" Margin="0,4,0,8" SelectionChanged="AnimationChanged"/>
                    <TextBlock Text="Sequence preview"/>
                    <UniformGrid Columns="2" Margin="0,4,0,6">
                        <ComboBox x:Name="AnimationPreviewModeBox" Margin="0,0,4,0" SelectionChanged="AnimationPreviewModeChanged">
                            <ComboBoxItem Tag="live" Content="Live data"/>
                            <ComboBoxItem Tag="loop" Content="Play loop"/>
                            <ComboBoxItem Tag="frame" Content="Single frame"/>
                        </ComboBox>
                        <Button x:Name="AnimationPlayButton" Content="Pause" Margin="4,0,0,0" Click="AnimationPlayClick"/>
                    </UniformGrid>
                    <Slider x:Name="AnimationFrameSlider" Minimum="0" Maximum="0" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="AnimationFrameSliderChanged"/>
                    <TextBlock x:Name="AnimationFrameInfo" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,8" Text="Select a sequence"/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="X"/><TextBox x:Name="AnimationXBox" Margin="0,4,0,0" TextChanged="AnimationChanged"/></StackPanel>
                        <StackPanel><TextBlock Text="Y"/><TextBox x:Name="AnimationYBox" Margin="0,4,0,0" TextChanged="AnimationChanged"/></StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Width"/><TextBox x:Name="AnimationWidthBox" Margin="0,4,0,0" TextChanged="AnimationChanged"/></StackPanel>
                        <StackPanel><TextBlock Text="Height"/><TextBox x:Name="AnimationHeightBox" Margin="0,4,0,0" TextChanged="AnimationChanged"/></StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Interval (ms)"/>
                    <TextBox x:Name="AnimationIntervalBox" Margin="0,4,0,8" TextChanged="AnimationChanged"/>
                    <TextBlock Text="Frames — click to inspect or adjust"/>
                    <ListBox x:Name="FrameList" Height="148" SelectionChanged="FrameSelected" Margin="0,4,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="64" Margin="2" Padding="3" Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" ToolTip="{Binding FileName}">
                                    <StackPanel>
                                        <Image Source="{Binding Preview}" Width="56" Height="56" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Selected frame alignment"/>
                    <UniformGrid Columns="2" Margin="0,4,0,8">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="X offset"/><TextBox x:Name="FrameOffsetXBox" Margin="0,4,0,0" TextChanged="FrameOffsetChanged"/></StackPanel>
                        <StackPanel><TextBlock Text="Y offset"/><TextBox x:Name="FrameOffsetYBox" Margin="0,4,0,0" TextChanged="FrameOffsetChanged"/></StackPanel>
                    </UniformGrid>
                    <Button x:Name="AddLibraryFramesButton" Content="Add icons as frames..." Margin="0,0,0,8" Click="OpenIconLibraryClick" ToolTip="Select library icons, then choose Add to selected sequence."/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button x:Name="AddFrameButton" Content="Add frames" Margin="0,0,4,4" Click="AddFramesToAnimationClick"/>
                        <Button x:Name="RemoveFrameButton" Content="Remove frame" Margin="4,0,0,4" Click="RemoveFrameClick"/>
                        <Button x:Name="MoveFrameUpButton" Content="↑ Move up" Margin="0,4,4,0" Click="MoveFrameUpClick"/>
                        <Button x:Name="MoveFrameDownButton" Content="↓ Move down" Margin="4,4,0,0" Click="MoveFrameDownClick"/>
                    </UniformGrid>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Modes select a frame from the current data. Battery uses 0–100%; other modes use the value modulo the frame count. Weekdays run Sunday–Saturday."/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="ELEMENT EDITOR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                            <TextBlock x:Name="SelectedName" FontSize="18" FontWeight="SemiBold" Text="No element selected" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Choose the data source and adjust the text on the watch preview or using the fields below."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button x:Name="AddButton" Content="New text" Margin="0,0,4,0" Click="AddClick"/>
                        <Button x:Name="RemoveButton" Content="Remove" Margin="4,0,0,0" Click="RemoveClick"/>
                    </UniformGrid>

                    <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="DATA SOURCE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="FunctionBox" Background="#332F29" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" Padding="8,5" SelectionChanged="FunctionChanged"/>
                            <TextBlock Text="Time, activity and values update on the watch." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock DockPanel.Dock="Left" Text="POSITION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                <TextBlock DockPanel.Dock="Right" Text="pixels · 368 × 448" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </DockPanel>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="X" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    <TextBox x:Name="XBox" Margin="0,3,0,0" TextChanged="CoordChanged"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <TextBlock Text="Y" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    <TextBox x:Name="YBox" Margin="0,3,0,0" TextChanged="CoordChanged"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                            <TextBlock Text="Text font" Foreground="{StaticResource Muted}" FontSize="11"/>
                            <ComboBox x:Name="FontChoiceBox" Margin="0,3,0,7" SelectionChanged="FontChoiceChanged"/>
                            <Button x:Name="LoadFontButton" Content="Load font (.ttf / .otf)" Margin="0,0,0,10" Click="LoadFontClick"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Size" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    <TextBox x:Name="SizeBox" Margin="0,3,0,0" TextChanged="FontSizeChanged"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <TextBlock Text="Color #RRGGBB" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    <TextBox x:Name="ColorBox" Margin="0,3,0,0" TextChanged="ColorChanged"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="CharacterInfo" Text="Font text." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <TextBlock Text="Character spacing (px)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
                            <TextBox x:Name="CharacterSpacingBox" Text="0" IsEnabled="False" Margin="0,3,0,0" TextChanged="CharacterSpacingChanged"/>
                            <TextBlock Text="Positive values separate characters; negative values bring them closer."
                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="The preview uses the same characters and positions exported to the watch."
                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1916" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="SAMPLE OR FIXED TEXT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <TextBox x:Name="SampleBox" MaxLength="12" ToolTip="Up to 12 characters per text element" TextChanged="SampleChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DockPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="#100E0C" CornerRadius="18" Padding="24">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="Watch" Width="368" Height="448" Background="Black" ClipToBounds="True">
                    <Image x:Name="BackgroundImage" Width="368" Height="448" Stretch="Fill"/>
                    <Canvas x:Name="Overlay" Width="368" Height="448" Background="Transparent"
                            MouseMove="CanvasMouseMove" MouseLeftButtonUp="CanvasMouseUp"
                            MouseLeftButtonDown="CanvasBackgroundMouseDown" LostMouseCapture="CanvasLostMouseCapture"
                            MouseLeave="CanvasMouseLeave"/>
                    <Canvas x:Name="ManipulationLayer" Width="368" Height="448"/>
                </Grid>
            </Viewbox>
        </Border>

        <DockPanel Grid.Column="2" Margin="16,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Output" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="Info" Foreground="White" FontSize="11" Margin="0,0,12,4"/>
                <TextBlock Text="Warning" Foreground="Gold" FontSize="11" Margin="0,0,12,4"/>
                <TextBlock Text="Error" Foreground="Red" FontSize="11" Margin="0,0,12,4"/>
                <TextBlock Text="Upload note" Foreground="DeepSkyBlue" FontSize="11" Margin="0,0,0,4"/>
            </WrapPanel>
            <RichTextBox x:Name="LogBox" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                     Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
                     BorderBrush="{StaticResource Line}" Padding="8">
                <FlowDocument PagePadding="0"/>
            </RichTextBox>
        </DockPanel>
    </Grid>
</Window>
